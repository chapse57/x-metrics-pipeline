{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheLake",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::ether-xmetrics-lake"
    },
    {
      "Sid": "ReadInputAndScript",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::ether-xmetrics-lake/media/podcasts/*", "arn:aws:s3:::ether-xmetrics-lake/glue-scripts/*"]
    },
    {
      "Sid": "WriteOutputAndTemp",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::ether-xmetrics-lake/media/aggregates/*", "arn:aws:s3:::ether-xmetrics-lake/glue-temp/*"]
    }
  ]
}
